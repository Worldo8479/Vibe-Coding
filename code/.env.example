# Choose ollama (local, no API credits), openai (paid API), or demo.
# Leave blank to preserve automatic OpenAI-if-key / demo-if-no-key behavior.
AI_PROVIDER=

# Local AI: install Ollama, then run: ollama pull qwen2.5-coder:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Only used when the selected provider is OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
# HOST=127.0.0.1
